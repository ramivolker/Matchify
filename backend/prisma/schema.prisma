generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoInteraccion {
  LIKE
  DISLIKE
}

enum Genero {
  MASCULINO
  FEMENINO
  NO_BINARIO
  OTRO
}

model Usuario {
  id              Int      @id @default(autoincrement())
  nombre          String
  apellido        String
  email           String   @unique
  fechaNacimiento DateTime
  biografia       String?  @db.VarChar(500)
  genero          Genero?
  activo          Boolean  @default(true)
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  ubicacionId Int?
  ubicacion   Ubicacion? @relation(fields: [ubicacionId], references: [id])

  tipoUsuarioId Int?
  tipoUsuario   TipoUsuario? @relation(fields: [tipoUsuarioId], references: [id])

  preferencia Preferencia?

  hobbies UsuarioHobbie[]

  interaccionesEnviadas  Interaccion[] @relation("InteraccionesEnviadas")
  interaccionesRecibidas Interaccion[] @relation("InteraccionesRecibidas")

  matchesComoUsuario1 Match[] @relation("MatchUsuario1")
  matchesComoUsuario2 Match[] @relation("MatchUsuario2")
  mensajes Mensaje[]

  bloqueosRealizados Bloqueo[] @relation("BloqueosRealizados")
  bloqueosRecibidos  Bloqueo[] @relation("BloqueosRecibidos")
}

model Ubicacion {
  id        Int    @id @default(autoincrement())
  ciudad    String
  provincia String
  pais      String
  latitud   Float
  longitud  Float

  usuarios Usuario[]
}

model Hobbie {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  emoji  String?

  usuarios UsuarioHobbie[]
}

model UsuarioHobbie {
  usuarioId Int
  hobbieId  Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  hobbie  Hobbie  @relation(fields: [hobbieId], references: [id], onDelete: Cascade)

  @@id([usuarioId, hobbieId])
}

model Preferencia {
  id             Int @id @default(autoincrement())
  usuarioId      Int @unique
  distanciaMaxKm Int @default(50)
  edadMinima     Int
  edadMaxima     Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  generos PreferenciaGenero[]
}

model PreferenciaGenero {
  preferenciaId Int
  genero Genero

  preferencia Preferencia @relation(fields: [preferenciaId], references: [id], onDelete: Cascade)

  @@id([preferenciaId, genero])
}

model TipoUsuario {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  usuarios Usuario[]
}

model Interaccion {
  id    Int             @id @default(autoincrement())
  tipo  TipoInteraccion
  fecha DateTime        @default(now())

  usuarioEmisorId       Int
  usuarioDestinatarioId Int

  usuarioEmisor Usuario @relation("InteraccionesEnviadas", fields: [usuarioEmisorId], references: [id], onDelete: Cascade)

  usuarioDestinatario Usuario @relation("InteraccionesRecibidas", fields: [usuarioDestinatarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioEmisorId, usuarioDestinatarioId])
}

model Match {
  id     Int      @id @default(autoincrement())
  fecha  DateTime @default(now())
  activo Boolean  @default(true)
  mensajes Mensaje[]

  usuario1Id Int
  usuario2Id Int

  usuario1 Usuario @relation("MatchUsuario1", fields: [usuario1Id], references: [id], onDelete: Cascade)

  usuario2 Usuario @relation("MatchUsuario2", fields: [usuario2Id], references: [id], onDelete: Cascade)

  @@unique([usuario1Id, usuario2Id])
}

model Mensaje {
  id        Int      @id @default(autoincrement())
  matchId   Int
  emisorId  Int
  contenido String   @db.VarChar(1000)
  enviadoEn DateTime @default(now())
  leido     Boolean  @default(false)

  match  Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  emisor Usuario @relation(fields: [emisorId], references: [id], onDelete: Cascade)

  @@index([matchId, enviadoEn])
}

model Bloqueo {
  id Int @id @default(autoincrement())

  usuarioBloqueadorId Int
  usuarioBloqueadoId  Int

  fecha DateTime @default(now())

  usuarioBloqueador Usuario @relation("BloqueosRealizados", fields: [usuarioBloqueadorId], references: [id], onDelete: Cascade)
  usuarioBloqueado  Usuario @relation("BloqueosRecibidos", fields: [usuarioBloqueadoId], references: [id], onDelete: Cascade)

  @@unique([usuarioBloqueadorId, usuarioBloqueadoId])
}
