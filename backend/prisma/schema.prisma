generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoInteraccion {
  LIKE
  DISLIKE
}

model Usuario {
  id              Int      @id @default(autoincrement())
  nombre          String
  apellido        String
  email           String   @unique
  fechaNacimiento DateTime
  biografia       String?  @db.VarChar(500)
  activo          Boolean  @default(true)
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt

  ubicacionId Int?
  ubicacion   Ubicacion? @relation(fields: [ubicacionId], references: [id])

  tipoUsuarioId Int?
  tipoUsuario   TipoUsuario? @relation(fields: [tipoUsuarioId], references: [id])

  preferencia Preferencia?

  hobbies UsuarioHobbie[]

  interaccionesEnviadas  Interaccion[] @relation("InteraccionesEnviadas")
  interaccionesRecibidas Interaccion[] @relation("InteraccionesRecibidas")

  matchesComoUsuario1 Match[] @relation("MatchUsuario1")
  matchesComoUsuario2 Match[] @relation("MatchUsuario2")
}

model Ubicacion {
  id        Int    @id @default(autoincrement())
  ciudad    String
  provincia String
  pais      String
  latitud   Float
  longitud  Float

  usuarios Usuario[]
}

model Hobbie {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  usuarios UsuarioHobbie[]
}

model UsuarioHobbie {
  usuarioId Int
  hobbieId  Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  hobbie  Hobbie  @relation(fields: [hobbieId], references: [id], onDelete: Cascade)

  @@id([usuarioId, hobbieId])
}

model Preferencia {
  id             Int @id @default(autoincrement())
  usuarioId      Int @unique
  distanciaMaxKm Int @default(50)
  edadMinima     Int
  edadMaxima     Int

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model TipoUsuario {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?

  usuarios Usuario[]
}

model Interaccion {
  id    Int             @id @default(autoincrement())
  tipo  TipoInteraccion
  fecha DateTime        @default(now())

  usuarioEmisorId       Int
  usuarioDestinatarioId Int

  usuarioEmisor Usuario @relation("InteraccionesEnviadas", fields: [usuarioEmisorId], references: [id], onDelete: Cascade)

  usuarioDestinatario Usuario @relation("InteraccionesRecibidas", fields: [usuarioDestinatarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioEmisorId, usuarioDestinatarioId])
}

model Match {
  id     Int      @id @default(autoincrement())
  fecha  DateTime @default(now())
  activo Boolean  @default(true)

  usuario1Id Int
  usuario2Id Int

  usuario1 Usuario @relation("MatchUsuario1", fields: [usuario1Id], references: [id], onDelete: Cascade)

  usuario2 Usuario @relation("MatchUsuario2", fields: [usuario2Id], references: [id], onDelete: Cascade)

  @@unique([usuario1Id, usuario2Id])
}
